{
  "name": "musclememory",
  "displayName": "Muscle Memory: IDE Theme & Keymap",
  "description": "Keep your IDE muscle memory in VS Code: dark and light themes, richer C#/Kotlin/Python styling, a classic-IDE keymap for macOS, Windows and Linux, inheritance gutter markers, a Switcher and a Push preview.",
  "version": "0.0.1",
  "publisher": "pavlo-zoria",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/PavloZoria/musclememory.git",
    "directory": "intellij/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Themes", "Keymaps"],
  "extensionKind": ["ui", "workspace"],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "package": "npm run lint && npm test && vsce package --no-dependencies --skip-license --out dist/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.1.1",
    "eslint": "^10.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "contributes": {
    "themes": [
      {
        "label": "Muscle Memory Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/musclememory-dark-color-theme.json"
      },
      {
        "label": "Muscle Memory Light",
        "uiTheme": "vs",
        "path": "./themes/musclememory-light-color-theme.json"
      }
    ],
    "commands": [
      {"command": "musclememory.selectOpenedFile", "title": "Select Opened File", "category": "Muscle Memory", "icon": "$(target)"},
      {"command": "musclememory.switcher", "title": "Switcher", "category": "Muscle Memory"},
      {"command": "musclememory.switcherBack", "title": "Switcher (Backward)", "category": "Muscle Memory"},
      {"command": "musclememory.push", "title": "Push…", "category": "Muscle Memory"},
      {"command": "musclememory.gotoSuper", "title": "Go to Super Method", "category": "Muscle Memory"},
      {"command": "musclememory.nextMethod", "title": "Next Method", "category": "Muscle Memory"},
      {"command": "musclememory.previousMethod", "title": "Previous Method", "category": "Muscle Memory"},
      {"command": "musclememory.refreshInheritanceMarkers", "title": "Refresh Inheritance Markers", "category": "Muscle Memory"},
      {"command": "musclememory.gutterGotoSuper", "title": "Go to Super Type/Method", "category": "Muscle Memory"},
      {"command": "musclememory.gutterShowInheritors", "title": "Show Implementations/Inheritors", "category": "Muscle Memory"}
    ],
    "configuration": {
      "title": "Muscle Memory",
      "properties": {
        "musclememory.inheritanceMarkers": {
          "type": "boolean",
          "default": true,
          "description": "Show inheritance gutter arrows on classes and members in C#, Kotlin and Java: ↑ implements/overrides, ↓ is implemented/overridden. Right-click an arrow to jump; hover the name for links."
        },
        "musclememory.inheritanceCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show clickable inheritance above declarations: \"↑ implements IOrderRepository\", \"↓ 2 implementations\"."
        },
        "musclememory.csharp.awaitableCalls": {
          "type": "boolean",
          "default": true,
          "description": "Color C# calls that return an awaitable (Task, ValueTask…) blue. The extension asks the C# server about calls on screen; turn this off to skip those requests."
        }
      }
    },
    "menus": {
      "view/title": [
        {"command": "musclememory.selectOpenedFile", "when": "view == workbench.explorer.fileView", "group": "navigation@50"}
      ],
      "editor/lineNumber/context": [
        {"command": "musclememory.gutterGotoSuper", "when": "editorLineNumber in musclememory.superLines", "group": "navigation@1"},
        {"command": "musclememory.gutterShowInheritors", "when": "editorLineNumber in musclememory.inheritorLines", "group": "navigation@2"}
      ],
      "commandPalette": [
        {"command": "musclememory.gutterGotoSuper", "when": "false"},
        {"command": "musclememory.gutterShowInheritors", "when": "false"}
      ]
    },
    "keybindings": [
      {"key": "ctrl+b", "mac": "cmd+b", "command": "editor.action.revealDefinition", "when": "editorHasDefinitionProvider && editorTextFocus"},
      {"key": "ctrl+alt+b", "mac": "cmd+alt+b", "command": "editor.action.goToImplementation", "when": "editorHasImplementationProvider && editorTextFocus"},
      {"key": "ctrl+shift+b", "command": "editor.action.goToTypeDefinition", "when": "editorHasTypeDefinitionProvider && editorTextFocus"},
      {"key": "cmd+shift+b", "command": "editor.action.goToTypeDefinition", "when": "isMac && editorHasTypeDefinitionProvider && editorTextFocus"},
      {"key": "ctrl+u", "mac": "cmd+u", "command": "musclememory.gotoSuper", "when": "editorTextFocus"},
      {"key": "ctrl+h", "command": "references-view.showTypeHierarchy", "when": "editorHasTypeHierarchyProvider && editorTextFocus"},
      {"key": "ctrl+alt+h", "command": "references-view.showCallHierarchy", "when": "editorHasCallHierarchyProvider && editorTextFocus"},
      {"key": "ctrl+shift+h", "mac": "cmd+shift+h", "command": "references-view.findImplementations", "when": "editorHasImplementationProvider && editorTextFocus"},
      {"key": "alt+f7", "command": "references-view.findReferences", "when": "editorHasReferenceProvider && editorTextFocus"},
      {"key": "ctrl+alt+f7", "mac": "cmd+alt+f7", "command": "editor.action.goToReferences", "when": "editorHasReferenceProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"},
      {"key": "ctrl+shift+f7", "mac": "cmd+shift+f7", "command": "editor.action.wordHighlight.trigger", "when": "editorTextFocus"},
      {"key": "ctrl+shift+i", "mac": "alt+space", "command": "editor.action.peekDefinition", "when": "editorHasDefinitionProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"},
      {"key": "cmd+y", "command": "editor.action.peekDefinition", "when": "isMac && editorHasDefinitionProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"},
      {"key": "ctrl+q", "mac": "f1", "command": "editor.action.showHover", "when": "editorTextFocus"},
      {"key": "ctrl+j", "command": "editor.action.showHover", "when": "isMac && editorTextFocus"},
      {"key": "ctrl+f1", "mac": "cmd+f1", "command": "editor.action.showHover", "when": "editorTextFocus"},
      {"key": "ctrl+shift+p", "command": "editor.action.showHover", "when": "isMac && editorTextFocus"},
      {"key": "ctrl+p", "mac": "cmd+p", "command": "editor.action.triggerParameterHints", "when": "editorHasSignatureHelpProvider && editorTextFocus"},
      {"key": "shift shift", "command": "workbench.action.quickOpen"},
      {"key": "ctrl+shift+n", "mac": "cmd+shift+o", "command": "workbench.action.quickOpen"},
      {"key": "ctrl+e", "mac": "cmd+e", "command": "workbench.action.quickOpen"},
      {"key": "ctrl+n", "mac": "cmd+o", "command": "workbench.action.showAllSymbols"},
      {"key": "ctrl+alt+shift+n", "mac": "cmd+alt+o", "command": "workbench.action.showAllSymbols"},
      {"key": "ctrl+shift+a", "mac": "cmd+shift+a", "command": "workbench.action.showCommands"},
      {"key": "ctrl+g", "mac": "cmd+l", "command": "workbench.action.gotoLine"},
      {"key": "ctrl+f12", "mac": "cmd+f12", "command": "workbench.action.gotoSymbol"},
      {"key": "cmd+[", "command": "workbench.action.navigateBack", "when": "isMac"},
      {"key": "ctrl+alt+left", "mac": "cmd+alt+left", "command": "workbench.action.navigateBack"},
      {"key": "cmd+]", "command": "workbench.action.navigateForward", "when": "isMac"},
      {"key": "ctrl+alt+right", "mac": "cmd+alt+right", "command": "workbench.action.navigateForward"},
      {"key": "ctrl+shift+backspace", "mac": "cmd+shift+backspace", "command": "workbench.action.navigateBackInEditLocations"},
      {"key": "alt+down", "mac": "ctrl+shift+down", "command": "musclememory.nextMethod", "when": "editorTextFocus"},
      {"key": "alt+up", "mac": "ctrl+shift+up", "command": "musclememory.previousMethod", "when": "editorTextFocus"},
      {"key": "f2", "command": "editor.action.marker.nextInFiles", "when": "editorFocus"},
      {"key": "shift+f2", "command": "editor.action.marker.prevInFiles", "when": "editorFocus"},
      {"key": "ctrl+alt+shift+down", "command": "workbench.action.editor.nextChange", "when": "editorTextFocus"},
      {"key": "ctrl+alt+shift+up", "command": "workbench.action.editor.previousChange", "when": "editorTextFocus"},
      {"key": "alt+home", "mac": "cmd+up", "command": "breadcrumbs.focusAndSelect", "when": "breadcrumbsPossible && breadcrumbsVisible && editorTextFocus"},
      {"key": "alt+f1", "command": "musclememory.selectOpenedFile"},
      {"key": "ctrl+tab", "command": "musclememory.switcher", "when": "!inQuickOpen"},
      {"key": "ctrl+shift+tab", "command": "musclememory.switcherBack", "when": "!inQuickOpen"},
      {"key": "ctrl+tab", "command": "workbench.action.quickOpenNavigateNextInEditorPicker", "when": "inQuickOpen && musclememory.switcherVisible"},
      {"key": "ctrl+shift+tab", "command": "workbench.action.quickOpenNavigatePreviousInEditorPicker", "when": "inQuickOpen && musclememory.switcherVisible"},
      {"key": "alt+enter", "command": "editor.action.quickFix", "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly"},
      {"key": "ctrl+alt+shift+t", "mac": "ctrl+t", "command": "editor.action.refactor", "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly"},
      {"key": "shift+f6", "command": "editor.action.rename", "when": "editorHasRenameProvider && editorTextFocus && !editorReadonly"},
      {"key": "shift+f6", "command": "renameFile", "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"},
      {"key": "alt+insert", "mac": "cmd+n", "command": "editor.action.sourceAction", "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly"},
      {"key": "alt+insert", "mac": "cmd+n", "command": "explorer.newFile", "when": "filesExplorerFocus && !inputFocus"},
      {"key": "ctrl+alt+m", "mac": "cmd+alt+m", "command": "editor.action.codeAction", "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly", "args": {"kind": "refactor.extract"}},
      {"key": "ctrl+alt+v", "mac": "cmd+alt+v", "command": "editor.action.codeAction", "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly", "args": {"kind": "refactor.extract"}},
      {"key": "ctrl+alt+c", "mac": "cmd+alt+c", "command": "editor.action.codeAction", "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly", "args": {"kind": "refactor.extract"}},
      {"key": "ctrl+alt+f", "mac": "cmd+alt+f", "command": "editor.action.codeAction", "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly", "args": {"kind": "refactor.extract"}},
      {"key": "ctrl+alt+n", "mac": "cmd+alt+n", "command": "editor.action.codeAction", "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly", "args": {"kind": "refactor.inline"}},
      {"key": "f6", "command": "editor.action.codeAction", "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly", "args": {"kind": "refactor.move"}},
      {"key": "ctrl+alt+t", "mac": "cmd+alt+t", "command": "editor.action.surroundWithSnippet", "when": "editorTextFocus && !editorReadonly"},
      {"key": "ctrl+j", "mac": "cmd+j", "command": "editor.action.insertSnippet", "when": "editorTextFocus && !editorReadonly"},
      {"key": "ctrl+shift+space", "command": "editor.action.triggerSuggest", "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly"},
      {"key": "ctrl+alt+o", "command": "editor.action.organizeImports", "when": "editorTextFocus && !editorReadonly && supportedCodeAction =~ /(\\s|^)source\\.organizeImports\\b/"},
      {"key": "ctrl+alt+l", "mac": "cmd+alt+l", "command": "editor.action.formatDocument", "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !editorHasSelection"},
      {"key": "ctrl+alt+l", "mac": "cmd+alt+l", "command": "editor.action.formatSelection", "when": "editorHasDocumentSelectionFormattingProvider && editorHasSelection && editorTextFocus && !editorReadonly"},
      {"key": "ctrl+d", "mac": "cmd+d", "command": "editor.action.copyLinesDownAction", "when": "editorTextFocus && !editorReadonly"},
      {"key": "ctrl+y", "mac": "cmd+backspace", "command": "editor.action.deleteLines", "when": "editorTextFocus && !editorReadonly"},
      {"key": "ctrl+shift+/", "mac": "cmd+alt+/", "command": "editor.action.blockComment", "when": "editorTextFocus && !editorReadonly"},
      {"key": "cmd+shift+/", "command": "editor.action.blockComment", "when": "isMac && editorTextFocus && !editorReadonly"},
      {"key": "ctrl+w", "mac": "alt+up", "command": "editor.action.smartSelect.expand", "when": "editorTextFocus"},
      {"key": "ctrl+shift+w", "mac": "alt+down", "command": "editor.action.smartSelect.shrink", "when": "editorTextFocus"},
      {"key": "ctrl+shift+up", "mac": "cmd+shift+up", "command": "editor.action.moveLinesUpAction", "when": "editorTextFocus && !editorReadonly"},
      {"key": "ctrl+shift+down", "mac": "cmd+shift+down", "command": "editor.action.moveLinesDownAction", "when": "editorTextFocus && !editorReadonly"},
      {"key": "alt+shift+up", "command": "editor.action.moveLinesUpAction", "when": "editorTextFocus && !editorReadonly"},
      {"key": "alt+shift+down", "command": "editor.action.moveLinesDownAction", "when": "editorTextFocus && !editorReadonly"},
      {"key": "alt+j", "mac": "ctrl+g", "command": "editor.action.addSelectionToNextFindMatch", "when": "editorFocus"},
      {"key": "ctrl+alt+shift+j", "mac": "ctrl+cmd+g", "command": "editor.action.selectHighlights", "when": "editorFocus"},
      {"key": "alt+shift+j", "mac": "ctrl+shift+g", "command": "cursorUndo", "when": "editorTextFocus"},
      {"key": "alt+shift+insert", "mac": "cmd+shift+8", "command": "editor.action.toggleColumnSelection"},
      {"key": "ctrl+-", "mac": "cmd+-", "command": "editor.fold", "when": "editorTextFocus && foldingEnabled"},
      {"key": "ctrl+=", "mac": "cmd+=", "command": "editor.unfold", "when": "editorTextFocus && foldingEnabled"},
      {"key": "ctrl+shift+-", "mac": "cmd+shift+-", "command": "editor.foldAll", "when": "editorTextFocus && foldingEnabled"},
      {"key": "ctrl+shift+=", "mac": "cmd+shift+=", "command": "editor.unfoldAll", "when": "editorTextFocus && foldingEnabled"},
      {"key": "shift+enter", "command": "editor.action.insertLineAfter", "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && !notebookEditorFocused"},
      {"key": "ctrl+alt+enter", "mac": "cmd+alt+enter", "command": "editor.action.insertLineBefore", "when": "editorTextFocus && !editorReadonly"},
      {"key": "ctrl+shift+j", "command": "editor.action.joinLines", "when": "editorTextFocus && !editorReadonly"},
      {"key": "ctrl+shift+m", "mac": "ctrl+m", "command": "editor.action.jumpToBracket", "when": "editorTextFocus"},
      {"key": "ctrl+r", "mac": "cmd+r", "command": "editor.action.startFindReplaceAction", "when": "editorFocus || editorIsOpen"},
      {"key": "ctrl+shift+r", "mac": "cmd+shift+r", "command": "workbench.action.replaceInFiles"},
      {"key": "ctrl+alt+down", "mac": "cmd+alt+down", "command": "search.action.focusNextSearchResult", "when": "hasSearchResult || inSearchEditor"},
      {"key": "ctrl+alt+up", "mac": "cmd+alt+up", "command": "search.action.focusPreviousSearchResult", "when": "hasSearchResult || inSearchEditor"},
      {"key": "alt+1", "mac": "cmd+1", "command": "workbench.action.toggleSidebarVisibility", "when": "sideBarFocus && activeViewlet == 'workbench.view.explorer'"},
      {"key": "alt+1", "mac": "cmd+1", "command": "workbench.view.explorer", "when": "!sideBarFocus || activeViewlet != 'workbench.view.explorer'"},
      {"key": "alt+3", "mac": "cmd+3", "command": "workbench.view.search"},
      {"key": "alt+4", "mac": "cmd+4", "command": "workbench.action.output.toggleOutput"},
      {"key": "alt+5", "mac": "cmd+5", "command": "workbench.view.debug"},
      {"key": "alt+6", "mac": "cmd+6", "command": "workbench.actions.view.problems"},
      {"key": "alt+7", "mac": "cmd+7", "command": "outline.focus"},
      {"key": "alt+9", "mac": "cmd+9", "command": "workbench.view.scm"},
      {"key": "alt+0", "mac": "cmd+0", "command": "workbench.view.scm"},
      {"key": "alt+f12", "command": "workbench.action.terminal.toggleTerminal"},
      {"key": "ctrl+shift+f12", "mac": "cmd+shift+f12", "command": "workbench.action.toggleMaximizeEditorGroup"},
      {"key": "shift+escape", "command": "workbench.action.closePanel", "when": "panelFocus"},
      {"key": "shift+escape", "command": "workbench.action.closeSidebar", "when": "sideBarFocus"},
      {"key": "alt+tab", "command": "workbench.action.focusNextGroup", "when": "isMac"},
      {"key": "alt+shift+tab", "command": "workbench.action.focusPreviousGroup", "when": "isMac"},
      {"key": "ctrl+shift+c", "mac": "cmd+shift+c", "command": "copyFilePath", "when": "!terminalFocus"},
      {"key": "ctrl+f9", "mac": "cmd+f9", "command": "workbench.action.tasks.build"},
      {"key": "shift+f10", "mac": "ctrl+r", "command": "workbench.action.debug.run", "when": "debuggersAvailable && debugState == 'inactive' && !terminalFocus"},
      {"key": "shift+f9", "mac": "ctrl+d", "command": "workbench.action.debug.start", "when": "debuggersAvailable && debugState == 'inactive' && !terminalFocus"},
      {"key": "alt+shift+f10", "mac": "ctrl+alt+r", "command": "workbench.action.debug.selectandstart", "when": "debuggersAvailable && !terminalFocus"},
      {"key": "alt+shift+f9", "mac": "ctrl+alt+d", "command": "workbench.action.debug.selectandstart", "when": "debuggersAvailable && !terminalFocus"},
      {"key": "ctrl+f2", "mac": "cmd+f2", "command": "workbench.action.debug.stop", "when": "inDebugMode"},
      {"key": "f8", "command": "workbench.action.debug.stepOver", "when": "debugState == 'stopped'"},
      {"key": "f7", "command": "workbench.action.debug.stepInto", "when": "debugState == 'stopped'"},
      {"key": "shift+f8", "command": "workbench.action.debug.stepOut", "when": "debugState == 'stopped'"},
      {"key": "f9", "command": "workbench.action.debug.continue", "when": "debugState == 'stopped'"},
      {"key": "cmd+alt+r", "command": "workbench.action.debug.continue", "when": "isMac && debugState == 'stopped'"},
      {"key": "alt+f9", "command": "editor.debug.action.runToCursor", "when": "debugState == 'stopped' && editorTextFocus"},
      {"key": "alt+f8", "command": "editor.debug.action.selectionToRepl", "when": "inDebugMode && editorHasSelection && editorTextFocus"},
      {"key": "alt+f8", "command": "workbench.debug.action.focusRepl", "when": "inDebugMode && !editorHasSelection"},
      {"key": "ctrl+f8", "mac": "cmd+f8", "command": "editor.debug.action.toggleBreakpoint", "when": "debuggersAvailable && editorTextFocus"},
      {"key": "ctrl+shift+f8", "mac": "cmd+shift+f8", "command": "workbench.debug.action.focusBreakpointsView"},
      {"key": "f7", "command": "workbench.action.compareEditor.nextChange", "when": "textCompareEditorVisible && debugState != 'stopped'"},
      {"key": "shift+f7", "command": "workbench.action.compareEditor.previousChange", "when": "textCompareEditorVisible"},
      {"key": "ctrl+k", "mac": "cmd+k", "command": "workbench.view.scm", "when": "!terminalFocus"},
      {"key": "ctrl+shift+k", "mac": "cmd+shift+k", "command": "musclememory.push", "when": "!terminalFocus"},
      {"key": "ctrl+t", "mac": "cmd+t", "command": "git.pull"},
      {"key": "ctrl+alt+z", "mac": "cmd+alt+z", "command": "git.revertSelectedRanges", "when": "editorTextFocus && !editorReadonly"}
    ]
  }
}
