    {
      "name": "Markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#287BDE" }
    },
    { "name": "Bold", "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "name": "Italic", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "Strikethrough", "scope": ["markup.strikethrough"], "settings": { "fontStyle": "strikethrough" } },
    { "name": "Diff inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#629755" } },
    { "name": "Diff deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#BC3F3C" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "#6897BB" } },
    {
      "name": "Kotlin annotation name",
      "scope": ["entity.name.function.annotation"],
      "settings": { "foreground": "#BBB529" }
    },
    {
      "name": "Kotlin string template ($name)",
      "scope": ["variable.other.interpolated.kotlin"],
      "settings": { "foreground": "#CC7832" }
    },
    {
      "name": "Kotlin string template expression (${...})",
      "scope": ["variable.other.interpolated.expression.kotlin"],
      "settings": { "foreground": "#A9B7C6" }
    },
    {
      "name": "C# method name (calls; declarations are colored by the extension)",
      "scope": ["entity.name.function.cs"],
      "settings": { "foreground": "#A9B7C6" }
    },
    {
      "name": "C# type",
      "scope": [
        "entity.name.type.cs",
        "entity.name.type.class.cs",
        "entity.name.type.struct.cs",
        "entity.name.type.enum.cs",
        "entity.name.type.delegate.cs",
        "entity.name.type.alias.cs",
        "entity.name.type.union.cs"
      ],
      "settings": { "foreground": "#4EC9B0" }
    },
    {
      "name": "C# interface declaration",
      "scope": ["entity.name.type.interface.cs"],
      "settings": { "foreground": "#4EC9B0", "fontStyle": "italic" }
    },
    {
      "name": "C# parameter",
      "scope": ["entity.name.variable.parameter.cs"],
      "settings": { "foreground": "#E0A3A3" }
    },
    {
      "name": "C# type parameter (Kotlin color)",
      "scope": ["entity.name.type.type-parameter.cs"],
      "settings": { "foreground": "#20999D" }
    },
    {
      "name": "Python self / cls",
      "scope": [
        "variable.parameter.function.language.special.self.python",
        "variable.language.special.self.python",
        "variable.parameter.function.language.special.cls.python",
        "variable.language.special.cls.python"
      ],
      "settings": { "foreground": "#94558D" }
    },
    {
      "name": "Python keyword argument",
      "scope": ["variable.parameter.function-call.python"],
      "settings": { "foreground": "#AA4926" }
    },
    {
      "name": "Python builtin",
      "scope": ["support.function.builtin.python", "support.type.python", "support.type.exception.python"],
      "settings": { "foreground": "#8888C6" }
    },
    {
      "name": "Python dunder (__init__, __name__)",
      "scope": ["support.function.magic.python", "support.variable.magic.python"],
      "settings": { "foreground": "#B200B2" }
    },
    {
      "name": "Python decorator",
      "scope": ["entity.name.function.decorator.python", "punctuation.definition.decorator.python"],
      "settings": { "foreground": "#BBB529" }
    },
    {
      "name": "Python docstring",
      "scope": ["string.quoted.docstring"],
      "settings": { "foreground": "#629755", "fontStyle": "italic" }
    },
    {
      "name": "Python f-string braces",
      "scope": ["constant.character.format.placeholder.other.python"],
      "settings": { "foreground": "#CC7832" }
    },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#BC3F3C" } },
    { "name": "Deprecated", "scope": ["invalid.deprecated"], "settings": { "fontStyle": "strikethrough" } }
  ],
