  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#808080" }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "comment.documentation",
        "comment.line.documentation",
        "comment.block.documentation punctuation.definition.comment",
        "comment.block.javadoc punctuation.definition.comment"
      ],
      "settings": { "foreground": "#629755", "fontStyle": "italic" }
    },
    {
      "name": "Doc comment tag (@param, @return)",
      "scope": [
        "storage.type.class.jsdoc",
        "keyword.other.documentation",
        "comment.block.documentation storage.type",
        "comment.block.javadoc keyword"
      ],
      "settings": { "foreground": "#629755", "fontStyle": "bold italic underline" }
    },
    {
      "name": "Doc comment tag value",
      "scope": [
        "variable.other.jsdoc",
        "variable.parameter.javadoc",
        "comment.block.documentation variable",
        "comment.block.javadoc variable",
        "comment.block.documentation string"
      ],
      "settings": { "foreground": "#8A653B", "fontStyle": "italic" }
    },
    {
      "name": "Doc comment markup",
      "scope": ["comment.block.documentation entity.name.tag", "comment.block.javadoc entity.name.tag"],
      "settings": { "foreground": "#77B767", "fontStyle": "italic" }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "constant.language",
        "variable.language",
        "support.type.primitive",
        "keyword.type",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.wordlike",
        "keyword.operator.word",
        "keyword.operator.instanceof",
        "keyword.operator.typeof",
        "keyword.operator.delete",
        "keyword.operator.void",
        "keyword.operator.in",
        "keyword.operator.of",
        "keyword.operator.is",
        "keyword.operator.as",
        "keyword.operator.logical.python"
      ],
      "settings": { "foreground": "#CC7832" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#A9B7C6" }
    },
    {
      "name": "Punctuation inside annotations stays plain",
      "scope": ["meta.annotation punctuation", "meta.decorator punctuation"],
      "settings": { "foreground": "#A9B7C6" }
    },
    {
      "name": "Comma and semicolon",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator.comma",
        "punctuation.separator.delimiter",
        "punctuation.separator.parameter",
        "punctuation.separator.array",
        "punctuation.separator.dictionary.pair"
      ],
      "settings": { "foreground": "#CC7832" }
    },
    {
      "name": "String",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#6A8759" }
    },
    {
      "name": "String escape and template braces",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.interpolation"
      ],
      "settings": { "foreground": "#CC7832" }
    },
    {
      "name": "Code inside string templates",
      "scope": ["meta.template.expression", "meta.embedded.interpolation", "meta.interpolation"],
      "settings": { "foreground": "#A9B7C6" }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#6897BB" }
    },
    {
      "name": "Function declaration",
      "scope": ["entity.name.function", "meta.definition.method entity.name.function", "meta.definition.function entity.name.function"],
      "settings": { "foreground": "#FFC66D" }
    },
    {
      "name": "Function call",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "meta.method-call entity.name.function",
        "support.function"
      ],
      "settings": { "foreground": "#A9B7C6" }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "storage.type.java",
        "storage.type.generic.java",
        "storage.type.object.array.java"
      ],
      "settings": { "foreground": "#A9B7C6" }
    },
    {
      "name": "Primitive type (Java)",
      "scope": ["storage.type.primitive"],
      "settings": { "foreground": "#CC7832" }
    },
    {
      "name": "Type parameter",
      "scope": ["entity.name.type.parameter", "entity.name.type.type-parameter", "variable.type.parameter"],
      "settings": { "foreground": "#507874" }
    },
    {
      "name": "Field and property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property",
        "entity.name.variable.field",
        "entity.name.variable.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "punctuation.support.type.property-name"
      ],
      "settings": { "foreground": "#9876AA" }
    },
    {
      "name": "Enum member and constant",
      "scope": ["variable.other.enummember", "entity.name.variable.enum-member", "constant.other.enum"],
      "settings": { "foreground": "#9876AA", "fontStyle": "italic" }
    },
    {
      "name": "Annotation and decorator",
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "punctuation.definition.annotation",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": { "foreground": "#BBB529" }
    },
    {
      "name": "XML/HTML tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag", "meta.tag.preprocessor.xml"],
      "settings": { "foreground": "#E8BF6A" }
    },
    {
      "name": "XML namespace prefix (android:)",
      "scope": ["entity.other.attribute-name.namespace", "entity.name.tag.namespace"],
      "settings": { "foreground": "#9876AA" }
    },
    {
      "name": "XML/HTML attribute name",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#BABABA" }
    },
    {
      "name": "HTML attribute value",
      "scope": ["text.html string.quoted", "text.html.derivative string"],
      "settings": { "foreground": "#A5C261" }
    },
    {
      "name": "Entity reference",
      "scope": ["constant.character.entity", "punctuation.definition.entity"],
      "settings": { "foreground": "#6D9CBE" }
    },
    {
      "name": "YAML key",
      "scope": ["entity.name.tag.yaml"],
      "settings": { "foreground": "#CC7832" }
    },
    {
      "name": "YAML plain value",
