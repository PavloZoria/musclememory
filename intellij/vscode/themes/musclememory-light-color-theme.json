  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8C8C8C"
      }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "comment.documentation",
        "comment.line.documentation",
        "comment.block.documentation punctuation.definition.comment",
        "comment.block.javadoc punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8C8C8C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tag (@param, @return)",
      "scope": [
        "storage.type.class.jsdoc",
        "keyword.other.documentation",
        "comment.block.documentation storage.type",
        "comment.block.javadoc keyword"
      ],
      "settings": {
        "foreground": "#8C8C8C",
        "fontStyle": "bold italic underline"
      }
    },
    {
      "name": "Doc comment tag value",
      "scope": [
        "variable.other.jsdoc",
        "variable.parameter.javadoc",
        "comment.block.documentation variable",
        "comment.block.javadoc variable",
        "comment.block.documentation string"
      ],
      "settings": {
        "foreground": "#8A653B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment markup",
      "scope": [
        "comment.block.documentation entity.name.tag",
        "comment.block.javadoc entity.name.tag"
      ],
      "settings": {
        "foreground": "#3B7F44",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "constant.language",
        "variable.language",
        "support.type.primitive",
        "keyword.type",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.wordlike",
        "keyword.operator.word",
        "keyword.operator.instanceof",
        "keyword.operator.typeof",
        "keyword.operator.delete",
        "keyword.operator.void",
        "keyword.operator.in",
        "keyword.operator.of",
        "keyword.operator.is",
        "keyword.operator.as",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#080808"
      }
    },
    {
      "name": "Punctuation inside annotations stays plain",
      "scope": [
        "meta.annotation punctuation",
        "meta.decorator punctuation"
      ],
      "settings": {
        "foreground": "#080808"
      }
    },
    {
      "name": "Comma and semicolon",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator.comma",
        "punctuation.separator.delimiter",
        "punctuation.separator.parameter",
        "punctuation.separator.array",
        "punctuation.separator.dictionary.pair"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#067D17"
      }
    },
    {
      "name": "String escape and template braces",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.interpolation"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "name": "Code inside string templates",
      "scope": [
        "meta.template.expression",
        "meta.embedded.interpolation",
        "meta.interpolation"
      ],
      "settings": {
        "foreground": "#080808"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#1750EB"
      }
    },
    {
      "name": "Function declaration",
      "scope": [
        "entity.name.function",
        "meta.definition.method entity.name.function",
        "meta.definition.function entity.name.function"
      ],
      "settings": {
        "foreground": "#00627A"
      }
    },
    {
      "name": "Function call",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "meta.method-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#080808"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "storage.type.java",
        "storage.type.generic.java",
        "storage.type.object.array.java"
      ],
      "settings": {
        "foreground": "#080808"
      }
    },
    {
      "name": "Primitive type (Java)",
      "scope": [
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "name": "Type parameter",
      "scope": [
        "entity.name.type.parameter",
        "entity.name.type.type-parameter",
        "variable.type.parameter"
      ],
      "settings": {
        "foreground": "#007E8A"
      }
    },
    {
      "name": "Field and property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property",
        "entity.name.variable.field",
        "entity.name.variable.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "punctuation.support.type.property-name"
      ],
      "settings": {
        "foreground": "#871094"
      }
    },
    {
      "name": "Enum member and constant",
      "scope": [
        "variable.other.enummember",
        "entity.name.variable.enum-member",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#871094",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Annotation and decorator",
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "punctuation.definition.annotation",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#9E880D"
      }
    },
    {
      "name": "XML/HTML tag",
      "scope": [
